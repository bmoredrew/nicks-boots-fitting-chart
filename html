#!/usr/bin/env ruby
# frozen_string_literal: true

require './calculate'
require './display'

def fractions(string)
  string
    .sub(' 1/2', '½')
    .sub(' 1/4', '¼')
    .sub(' 3/4', '¾')
    .sub(' 1/8', '⅛')
    .sub(' 3/8', '⅜')
    .sub(' 5/8', '⅝')
    .sub(' 7/8', '⅞')
end

puts '<!DOCTYPE html>'
puts '<html lang="en">'
puts '<head>'
puts '<meta charset="UTF-8">'
puts '<meta name="viewport" content="width=device-width, initial-scale=1.0">'
puts '<title>Nicks Boots Fitting Chart</title>'
puts '<style>'
puts 'body { font-family: Arial, sans-serif; margin: 20px; }'
puts 'table { border-collapse: collapse; }'
puts 'th, td { border: 1px solid #ddd; padding: 8px; text-align: center; }'
puts 'th { background-color: #f2f2f2; font-weight: bold; }'
puts 'tfoot th { background-color: #f2f2f2; }'
puts 'tr:hover { background-color: #f5f5f5; }'
puts '</style>'
puts '</head>'
puts '<body>'
puts '<h1>Nicks Handmade Boots Fitting Chart</h1>'
puts '<table>'

puts '<thead>'
puts '<tr>'
puts '<th rowspan=2>Width</th>'
puts '<th rowspan=2>Measure</th>'
puts "<th colspan=#{$sizes.count}>Size</th>"
puts '</tr>'
puts '<tr>'
$sizes.each { |size| print "<th>#{fractions(size)}</th>" }
puts '</tr>'
puts '</thead>'

puts '<tfoot>'
puts '<tr>'
puts '<th>Width</th>'
puts '<th>Measure</th>'
$sizes.each { |size| print "<th>#{fractions(size)}</th>" }
puts '</tr>'
puts '</tfoot>'

puts '<tbody>'
$widths.each do |width|
  %i[ball instep heel].each_with_index do |measure, measure_index|
    puts '<tr>'
    puts "<th rowspan=3>#{width}</th>" if measure_index.zero?
    puts "<th>#{measure.to_s.capitalize}</th>"
    $sizes.each do |size|
      print "<td>#{fractions(display($data[size][width][measure]))}</td>"
    end
    puts '</tr>'
  end
end
puts '</tbody>'

puts '</table>'
puts '</body>'
puts '</html>'
